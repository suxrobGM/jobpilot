<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>JobPilot.Terminal</RootNamespace>
    <AssemblyName>jobpilot</AssemblyName>
    <Version>2.1.29</Version>
    <ApplicationIcon>jobpilot.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Quick.PtyNet" Version="1.0.4" />
    <!-- DPAPI for the pilot token at rest on Windows; a P/Invoke shim that is trim/AOT safe. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobPilot.Terminal.Tests" />
  </ItemGroup>

  <!-- Native AOT emits a .pdb on Windows despite DebugType=none; drop it from the publish output. -->
  <Target Name="TrimPublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_JobPilotStalePublish Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_JobPilotStalePublish)" />
  </Target>

  <!-- Ship the shared plugin/ tree for Claude and JobPilot runtime resources. -->
  <ItemGroup>
    <Content Include="..\..\plugin\**\*">
      <Link>plugin\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Codex loads the user-installed marketplace plugin; these repo-scoped agents provide worker parity with Claude. -->
    <Content Include="..\..\.codex\agents\*.toml">
      <Link>.codex\agents\%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
