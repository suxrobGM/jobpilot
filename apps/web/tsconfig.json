{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["bun"],

    "jsx": "react-jsx",
    "allowJs": true,
    "incremental": true,
    "strict": true,

    // The path aliases below pull in API source (which uses tsyringe parameter
    // decorators), so the web typecheck must accept experimental decorators too.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/common/*": ["../api/src/common/*"],
      "@/modules/*": ["../api/src/modules/*"],
      "@/generated/*": ["../api/src/generated/*"],
      "@/types/*": ["../api/src/types/*"],
      "@/env": ["../api/src/env"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
