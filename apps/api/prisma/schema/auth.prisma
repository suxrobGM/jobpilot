enum VerificationTokenType {
  email_verification
  password_reset
  email_change

  @@map("verification_token_type")
}

// Single-use emailed tokens. Stores only the hash.
model VerificationToken {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash")
  // `email_change` only: the address to switch to.
  newEmail   String?               @map("new_email")
  expiresAt  DateTime              @map("expires_at")
  consumedAt DateTime?             @map("consumed_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

enum OAuthProvider {
  google
  github

  @@map("oauth_provider")
}

// A linked sign-in identity. Stores no provider tokens.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  // The provider's address at link time; display only.
  email             String?
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

enum AuthTokenKind {
  session
  terminal

  @@map("auth_token_kind")
}

// Web sessions and the terminal token. Hash-only, except `tokenCipher`, which lets the web
// re-fetch the terminal token.
model AuthToken {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  kind        AuthTokenKind
  tokenHash   String        @unique @map("token_hash")
  tokenCipher String?       @map("token_cipher")
  lastUsedAt  DateTime?     @map("last_used_at")
  // Sessions only; the terminal token lives until revoked.
  expiresAt   DateTime?     @map("expires_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_tokens")
}
