enum VerificationTokenType {
  email_verification
  password_reset
  email_change

  @@map("verification_token_type")
}

// Single-use emailed tokens. Stores only the hash.
model VerificationToken {
  id         String                @id @default(uuid(7)) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash")
  // `email_change` only: the address to switch to.
  newEmail   String?               @map("new_email")
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

enum OAuthProvider {
  google
  github

  @@map("oauth_provider")
}

// A linked sign-in identity. Stores no provider tokens.
model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  // The provider's address at link time; display only.
  email             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

enum AuthTokenKind {
  session
  terminal

  @@map("auth_token_kind")
}

// Web sessions and the terminal token. Hash-only, except `encryptedToken`, which lets the web
// re-fetch the terminal token.
model AuthToken {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  kind           AuthTokenKind
  tokenHash      String        @unique @map("token_hash")
  encryptedToken String?       @map("encrypted_token")
  lastUsedAt     DateTime?     @map("last_used_at") @db.Timestamptz(3)
  // Sessions only; the terminal token lives until revoked.
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_tokens")
}
