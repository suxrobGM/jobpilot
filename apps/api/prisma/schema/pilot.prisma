enum PilotRunOutcome {
  done
  failed
  cancelled
  expired

  @@map("pilot_run_outcome")
}

enum PilotQuestionKind {
  question
  choice
  two_factor
  approval

  @@map("pilot_question_kind")
}

enum PilotChangeSource {
  user
  chat
  pilot
  notice

  @@map("pilot_change_source")
}

enum PilotChangeStatus {
  proposed
  applied
  undone
  dismissed

  @@map("pilot_change_status")
}

enum PilotQuestionStatus {
  open
  answered
  expired
  cancelled

  @@map("pilot_question_status")
}

enum PilotJournalKind {
  cycle
  action
  question
  system
  digest
  correction

  @@map("pilot_journal_kind")
}

// What a run, question or journal entry is about. `subjectId` stays text: it holds ids and keys
// like `inbox` or `<campaignId>:<jobKey>`.
enum PilotSubjectType {
  job
  campaign
  question
  networking
  inbox
  promotion
  application
  email
  board
  pilot
  upwork

  @@map("pilot_subject_type")
}

enum PromotionStatus {
  draft
  approved
  declined
  posted
  failed
  skipped
  expired

  @@map("promotion_status")
}

model PilotState {
  userId                String    @id @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  running               Boolean   @default(false)
  instructionsGoals     String    @default("") @map("instructions_goals")
  instructionsConfig    Json      @default("{}") @map("instructions_config")
  instructionsUpdatedAt DateTime? @map("instructions_updated_at") @db.Timestamptz(3)
  taskListVersion       String?   @map("task_list_version")
  taskListExpiresAt     DateTime? @map("task_list_expires_at") @db.Timestamptz(3)
  taskListSnapshot      Json?     @map("task_list_snapshot")
  lastCycleAt           DateTime? @map("last_cycle_at") @db.Timestamptz(3)
  // When the host plans its next task list check; idle checks write here, not to the journal.
  nextWakeAt            DateTime? @map("next_wake_at") @db.Timestamptz(3)
  cycleCount            Int       @default(0) @map("cycle_count")
  // "Run now" for the job-alert import: offered off-schedule until a later run or an hour passes.
  jobAlertsRequestedAt  DateTime? @map("job_alerts_requested_at") @db.Timestamptz(3)
  // "Research now": offered ungated until a later research run or an hour passes.
  researchRequestedAt   DateTime? @map("research_requested_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pilot_states")
}

model PilotSearch {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The plain name the user sees; the query is shown on expand.
  name         String
  query        String
  boardId      String?   @map("board_id") @db.Uuid
  board        JobBoard? @relation(fields: [boardId], references: [id], onDelete: SetNull)
  resumeId     String?   @map("resume_id") @db.Uuid
  resume       Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  // The pilot's one-liner on why it chose this search, shown verbatim in the web UI.
  reason       String    @default("")
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastJobsScanned Int?  @map("last_jobs_scanned")
  lastNewJobs  Int?      @map("last_new_jobs")
  // Consecutive runs with no new jobs; 3 or more backs the search off.
  emptyRuns    Int       @default(0) @map("empty_runs")
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // A run opens a new campaign once the previous one completes.
  campaigns Campaign[]

  @@index([userId, nextRunAt])
  @@index([boardId])
  @@index([resumeId])
  @@map("pilot_searches")
}

model PilotRun {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType         String           @map("task_type")
  subjectType      PilotSubjectType @map("subject_type")
  subjectId        String           @map("subject_id")
  payload          Json             @default("{}")
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  heartbeatAt      DateTime?        @map("heartbeat_at") @db.Timestamptz(3)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(3)
  outcome          PilotRunOutcome?
  // Null until the host reports the usage of the cycle that started this run.
  model            String?
  inputTokens      Int              @default(0) @map("input_tokens")
  outputTokens     Int              @default(0) @map("output_tokens")
  cacheReadTokens  Int              @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int              @default(0) @map("cache_write_tokens")

  journalEntries PilotJournalEntry[]
  changes        PilotChange[]

  @@index([userId, subjectType, subjectId])
  @@index([finishedAt])
  // Partial indexes live in the migration SQL: open runs by (userId, expiresAt), and one open run per
  // (userId, subjectType, subjectId). Finished rows stay as history for the retry damper.
  @@map("pilot_runs")
}

model PilotQuestion {
  id             String              @id @default(uuid(7)) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           PilotQuestionKind
  status         PilotQuestionStatus @default(open)
  subjectType    PilotSubjectType?   @map("subject_type")
  subjectId      String?             @map("subject_id")
  prompt         String
  options        Json                @default("[]")
  link           String?
  answer         String?
  savedAnswerKey String?             @map("saved_answer_key")
  answeredAt     DateTime?           @map("answered_at") @db.Timestamptz(3)
  expiresAt      DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("pilot_questions")
}

model PilotJournalEntry {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The run whose cycle wrote this entry.
  runId       String?           @map("run_id") @db.Uuid
  run         PilotRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind        PilotJournalKind
  summary     String
  detail      Json              @default("{}")
  subjectType PilotSubjectType? @map("subject_type")
  subjectId   String?           @map("subject_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@index([runId])
  @@map("pilot_journal_entries")
}

model PromotionPost {
  id           String          @id @default(uuid(7)) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  target       String?
  title        String?
  body         String
  status       PromotionStatus @default(draft)
  postedUrl    String?         @map("posted_url")
  scheduledFor DateTime?       @map("scheduled_for") @db.Timestamptz(3)
  postedAt     DateTime?       @map("posted_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, status])
  @@index([updatedAt]) // Retention sweep.
  @@map("promotion_posts")
}

/** An edit to goals, rules, searches, answers or jobs, applied with an inverse or proposed. */
model PilotChange {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    PilotChangeSource
  status    PilotChangeStatus
  summary   String
  actions   Json
  // The inverse actions, set once applied; replaying them undoes the change.
  undo      Json?
  runId     String?           @map("run_id") @db.Uuid
  run       PilotRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime?         @map("decided_at") @db.Timestamptz(3)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([runId])
  @@map("pilot_changes")
}
