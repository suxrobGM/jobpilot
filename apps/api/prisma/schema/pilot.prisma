enum PilotRunOutcome {
  done
  failed
  cancelled
  expired

  @@map("pilot_run_outcome")
}

enum PilotQuestionKind {
  question
  choice
  two_factor
  approval

  @@map("pilot_question_kind")
}

enum PilotQuestionStatus {
  open
  answered
  expired
  cancelled

  @@map("pilot_question_status")
}

enum PilotJournalKind {
  cycle
  action
  question
  system
  digest
  correction

  @@map("pilot_journal_kind")
}

enum PromotionStatus {
  draft
  approved
  declined
  posted
  failed
  skipped
  expired

  @@map("promotion_status")
}

model PilotState {
  userId                String    @id @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  running               Boolean   @default(false)
  instructionsGoals     String    @default("") @map("instructions_goals")
  instructionsConfig    Json      @default("{}") @map("instructions_config")
  instructionsUpdatedAt DateTime? @map("instructions_updated_at")
  taskListVersion       String?   @map("task_list_version")
  taskListBuiltAt       DateTime? @map("task_list_built_at")
  taskListExpiresAt     DateTime? @map("task_list_expires_at")
  taskListSnapshot      Json?     @map("task_list_snapshot")
  lastCycleAt           DateTime? @map("last_cycle_at")
  // When the host plans its next task list check; idle checks write here, not to the journal.
  nextWakeAt            DateTime? @map("next_wake_at")
  cycleCount            Int       @default(0) @map("cycle_count")
  // "Run now" on the job-alert harvest: offered on the next task list even off-schedule, until a run
  // after it or JOB_ALERTS_REQUEST_TTL_MS passes.
  jobAlertsRequestedAt  DateTime? @map("job_alerts_requested_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("pilot_states")
}

model PilotSearch {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        String
  board        String?
  resumeId     String?   @map("resume_id")
  // The pilot's one-liner on why it chose this search, shown verbatim in the web UI.
  reason       String    @default("")
  lastRunAt    DateTime? @map("last_run_at")
  lastJobsSeen Int?      @map("last_jobs_seen")
  lastNewJobs  Int?      @map("last_new_jobs")
  // Consecutive runs with zero new jobs; drives the dry-search backoff, "backing off" >= 3.
  emptyRuns    Int       @default(0) @map("empty_runs")
  nextRunAt    DateTime  @default(now()) @map("next_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // A run opens a new campaign once the previous one completes.
  campaigns Campaign[]

  @@index([userId, nextRunAt])
  @@map("pilot_searches")
}

model PilotRun {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType         String           @map("task_type")
  subjectType      String           @map("subject_type")
  subjectId        String           @map("subject_id")
  payload          Json             @default("{}")
  startedAt        DateTime         @default(now()) @map("started_at")
  heartbeatAt      DateTime?        @map("heartbeat_at")
  expiresAt        DateTime         @map("expires_at")
  finishedAt       DateTime?        @map("finished_at")
  outcome          PilotRunOutcome?
  // Null until the host reports the usage of the cycle that started this run.
  model            String?
  inputTokens      Int              @default(0) @map("input_tokens")
  outputTokens     Int              @default(0) @map("output_tokens")
  cacheReadTokens  Int              @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int              @default(0) @map("cache_write_tokens")

  @@index([userId, expiresAt])
  @@index([userId, subjectType, subjectId])
  @@index([finishedAt])
  // No @@unique on (userId, taskType, subject): one open run per subject is an *open*-run rule, and
  // finished rows are kept as history for the retry damper. RunService enforces it in-transaction.
  @@map("pilot_runs")
}

model PilotQuestion {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        PilotQuestionKind
  status      PilotQuestionStatus @default(open)
  subjectType String?             @map("subject_type")
  subjectId   String?             @map("subject_id")
  prompt      String
  options     Json                @default("[]")
  deepLink    String?             @map("deep_link")
  answer      String?
  answerKey   String?             @map("answer_key")
  answeredAt  DateTime?           @map("answered_at")
  expiresAt   DateTime?           @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("pilot_questions")
}

// Only user-given answers land here; the model's guesses never do.
model ProfileAnswer {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("profile_answers")
}

model PilotJournalEntry {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String?          @map("cycle_id")
  kind        PilotJournalKind
  summary     String
  detail      Json             @default("{}")
  subjectType String?          @map("subject_type")
  subjectId   String?          @map("subject_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@map("pilot_journal_entries")
}

model PromotionPost {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  target       String?
  title        String?
  body         String
  status       PromotionStatus @default(draft)
  postedUrl    String?         @map("posted_url")
  scheduledFor DateTime?       @map("scheduled_for")
  postedAt     DateTime?       @map("posted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([updatedAt]) // Retention sweep; the userId-leading index cannot serve it.
  @@map("promotion_posts")
}
