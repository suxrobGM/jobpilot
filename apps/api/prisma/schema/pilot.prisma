enum PilotClaimOutcome {
  done
  failed
  abandoned
  expired
}

enum PilotQuestionKind {
  question
  choice
  two_factor @map("2fa")
  approval
}

enum PilotQuestionStatus {
  open
  answered
  expired
  cancelled
}

enum PilotJournalKind {
  cycle
  action
  observation
  question
  system
  digest
  correction
}

enum PromotionStatus {
  draft
  approved
  declined
  posted
  failed
  skipped
  expired
}

model PilotState {
  userId                String    @id @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  running               Boolean   @default(false)
  instructionsGoals     String    @default("") @map("instructions_goals")
  instructionsConfig    Json      @default("{}") @map("instructions_config")
  instructionsUpdatedAt DateTime? @map("instructions_updated_at")
  agendaVersion         String?   @map("agenda_version")
  agendaGeneratedAt     DateTime? @map("agenda_generated_at")
  agendaExpiresAt       DateTime? @map("agenda_expires_at")
  agendaSnapshot        Json?     @map("agenda_snapshot")
  lastCycleAt           DateTime? @map("last_cycle_at")
  cycleCount            Int       @default(0) @map("cycle_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("pilot_states")
}

model PilotSearch {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        String
  board        String?
  resumeId     String?   @map("resume_id")
  // The pilot's one-liner on why it chose this search, shown verbatim in the web UI.
  reason       String    @default("")
  lastRunAt    DateTime? @map("last_run_at")
  lastJobsSeen Int?      @map("last_jobs_seen")
  lastNewJobs  Int?      @map("last_new_jobs")
  // Consecutive runs with zero new jobs; drives the dry-search backoff, "backing off" >= 3.
  emptyRuns    Int       @default(0) @map("empty_runs")
  nextRunAt    DateTime  @default(now()) @map("next_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, nextRunAt])
  @@map("pilot_searches")
}

model PilotClaim {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  subjectType String             @map("subject_type")
  subjectId   String             @map("subject_id")
  payload     Json               @default("{}")
  grantedAt   DateTime           @default(now()) @map("granted_at")
  heartbeatAt DateTime?          @map("heartbeat_at")
  expiresAt   DateTime           @map("expires_at")
  releasedAt  DateTime?          @map("released_at")
  outcome     PilotClaimOutcome?

  @@index([userId, expiresAt])
  @@index([userId, subjectType, subjectId])
  @@index([releasedAt])
  // No @@unique on (userId, kind, subject): one open claim per subject is an *open*-claim rule, and
  // released rows are kept as history for the retry damper. ClaimService enforces it in-transaction.
  @@map("pilot_claims")
}

model PilotQuestion {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        PilotQuestionKind
  status      PilotQuestionStatus @default(open)
  subjectType String?             @map("subject_type")
  subjectId   String?             @map("subject_id")
  prompt      String
  options     Json                @default("[]")
  deepLink    String?             @map("deep_link")
  answer      String?
  answeredAt  DateTime?           @map("answered_at")
  expiresAt   DateTime?           @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("pilot_questions")
}

model PilotJournalEntry {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String?          @map("cycle_id")
  kind        PilotJournalKind
  summary     String
  detail      Json             @default("{}")
  subjectType String?          @map("subject_type")
  subjectId   String?          @map("subject_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([createdAt])
  @@map("pilot_journal_entries")
}

model PromotionPost {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  target       String?
  title        String?
  body         String
  status       PromotionStatus @default(draft)
  postedUrl    String?         @map("posted_url")
  scheduledFor DateTime?       @map("scheduled_for")
  postedAt     DateTime?       @map("posted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([updatedAt]) // Retention sweep; the userId-leading index cannot serve it.
  @@map("promotion_posts")
}
