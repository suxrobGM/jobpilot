enum PilotRunOutcome {
  done
  failed
  cancelled
  expired

  @@map("pilot_run_outcome")
}

enum PilotQuestionKind {
  question
  choice
  two_factor
  approval

  @@map("pilot_question_kind")
}

enum PilotChangeSource {
  user
  chat
  pilot
  notice

  @@map("pilot_change_source")
}

enum PilotChangeStatus {
  proposed
  applied
  undone
  dismissed

  @@map("pilot_change_status")
}

enum PilotMessageAuthor {
  user
  pilot

  @@map("pilot_message_author")
}

enum PilotRequestStatus {
  pending
  running
  done
  failed
  cancelled

  @@map("pilot_request_status")
}

enum PilotRequestSource {
  web
  chat
  notice

  @@map("pilot_request_source")
}

enum PilotQuestionStatus {
  open
  answered
  expired
  cancelled

  @@map("pilot_question_status")
}

// What a run, question or request is about. `subjectId` stays text: it holds ids and keys
// like `inbox` or `<feedId>:<jobKey>`.
enum PilotSubjectType {
  job
  feed
  question
  networking
  inbox
  application
  email
  board
  pilot
  upwork
  chat
  resume
  request

  @@map("pilot_subject_type")
}

model PilotState {
  userId           String    @id @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Autopilot is on while set. Autonomous work runs only then; requests, chat and answered
  // questions always run. `cap.unused` waits for a week of it.
  autopilotSince   DateTime? @map("autopilot_since") @db.Timestamptz(3)
  // Rules and settings; `pilotConfigSchema` parses it.
  config           Json      @default("{}")
  // The live task list; `taskListSchema` parses it, and its `expiresAt` says when it goes stale.
  taskList         Json?     @map("task_list")
  lastCycleAt      DateTime? @map("last_cycle_at") @db.Timestamptz(3)
  // When the host plans its next task list check.
  nextWakeAt       DateTime? @map("next_wake_at") @db.Timestamptz(3)
  cycleCount       Int       @default(0) @map("cycle_count")
  // The last morning digest, so one goes out per day.
  digestAt         DateTime? @map("digest_at") @db.Timestamptz(3)
  // Notice key to the ISO time it may show again.
  dismissedNotices Json      @default("{}") @map("dismissed_notices")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pilot_states")
}

model PilotRun {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType         String           @map("task_type")
  // The task's title when the run started, so old runs never need their payload parsed.
  title            String
  subjectType      PilotSubjectType @map("subject_type")
  subjectId        String           @map("subject_id")
  payload          Json             @default("{}")
  startedAt        DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  heartbeatAt      DateTime?        @map("heartbeat_at") @db.Timestamptz(3)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(3)
  outcome          PilotRunOutcome?
  // The agent's one-line result; null for runs that closed without one (cancelled, expired).
  summary          String?
  // The run picked up work the user asked for in chat, so it answers there.
  askedInChat      Boolean          @default(false) @map("asked_in_chat")
  // Null until the host reports the usage of the cycle that started this run.
  model            String?
  inputTokens      Int              @default(0) @map("input_tokens")
  outputTokens     Int              @default(0) @map("output_tokens")
  cacheReadTokens  Int              @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int              @default(0) @map("cache_write_tokens")

  changes  PilotChange[]
  messages PilotMessage[]
  requests PilotRequest[]

  @@index([userId, subjectType, subjectId])
  @@index([userId, finishedAt])
  @@index([finishedAt])
  // Partial indexes live in the migration SQL: open runs by (userId, expiresAt), and one open run per
  // (userId, subjectType, subjectId). Finished rows stay as history for the retry damper.
  @@map("pilot_runs")
}

model PilotQuestion {
  id             String              @id @default(uuid(7)) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           PilotQuestionKind
  status         PilotQuestionStatus @default(open)
  subjectType    PilotSubjectType?   @map("subject_type")
  subjectId      String?             @map("subject_id")
  prompt         String
  options        Json                @default("[]")
  link           String?
  answer         String?
  savedAnswerKey String?             @map("saved_answer_key")
  answeredAt     DateTime?           @map("answered_at") @db.Timestamptz(3)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("pilot_questions")
}

/**
 * An edit to rules, searches, answers or jobs, applied with an inverse or proposed.
 */
model PilotChange {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    PilotChangeSource
  status    PilotChangeStatus
  summary   String
  actions   Json
  // The inverse actions, set once applied; replaying them undoes the change.
  undo      Json?
  runId     String?           @map("run_id") @db.Uuid
  run       PilotRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime?         @map("decided_at") @db.Timestamptz(3)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([runId])
  @@map("pilot_changes")
}

/**
 * The conversation with the pilot: the user's messages and its replies.
 */
model PilotMessage {
  id        String             @id @default(uuid(7)) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    PilotMessageAuthor
  body      String
  // The chat.reply run that wrote a pilot message.
  runId     String?            @map("run_id") @db.Uuid
  run       PilotRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([runId])
  @@map("pilot_messages")
}

/**
 * Work the user asked for by name; it follows the run that picks it up.
 */
model PilotRequest {
  id          String             @id @default(uuid(7)) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType    String             @map("task_type")
  // The request's input, expanded into a task payload when the task list is built.
  payload     Json               @default("{}")
  // The task's subject, so the run that starts on it can be matched back.
  subjectType PilotSubjectType   @map("subject_type")
  subjectId   String             @map("subject_id")
  status      PilotRequestStatus @default(pending)
  source      PilotRequestSource
  runId       String?            @map("run_id") @db.Uuid
  run         PilotRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime?          @map("finished_at") @db.Timestamptz(3)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([runId])
  @@map("pilot_requests")
}
