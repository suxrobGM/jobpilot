model PilotState {
  profileId             String    @id @map("profile_id")
  profile               Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  enabled               Boolean   @default(false)
  instructionsGoals     String    @default("") @map("instructions_goals")
  instructionsConfig    String    @default("{}") @map("instructions_config")
  instructionsUpdatedAt DateTime? @map("instructions_updated_at")
  lastCycleAt           DateTime? @map("last_cycle_at")
  cycleCount            Int       @default(0) @map("cycle_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("pilot_states")
}

model PilotLease {
  id          String    @id @default(uuid())
  profileId   String    @map("profile_id")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind        String
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id")
  payload     String    @default("{}")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  heartbeatAt DateTime? @map("heartbeat_at")
  expiresAt   DateTime  @map("expires_at")
  releasedAt  DateTime? @map("released_at")
  outcome     String?

  @@index([profileId, expiresAt])
  @@map("pilot_leases")
}

model Question {
  id          String    @id @default(uuid())
  profileId   String    @map("profile_id")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind        String
  status      String    @default("open")
  subjectType String?   @map("subject_type")
  subjectId   String?   @map("subject_id")
  prompt      String
  options     String    @default("[]")
  deepLink    String?   @map("deep_link")
  answer      String?
  answeredAt  DateTime? @map("answered_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([profileId, status])
  @@map("questions")
}

model PilotJournalEntry {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cycleId     String?  @map("cycle_id")
  kind        String
  summary     String
  detail      String   @default("{}")
  subjectType String?  @map("subject_type")
  subjectId   String?  @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([profileId, createdAt])
  @@map("pilot_journal_entries")
}

model PromotionPost {
  id           String    @id @default(uuid())
  profileId    String    @map("profile_id")
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform     String // "hn-whoishiring" | "reddit:r/forhire" | "linkedin-post"
  target       String? // thread/subreddit URL when known
  title        String?
  body         String
  status       String    @default("draft") // draft | approved | declined | posted | failed | skipped | expired
  postedUrl    String?   @map("posted_url")
  scheduledFor DateTime? @map("scheduled_for")
  postedAt     DateTime? @map("posted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([profileId, status])
  @@map("promotion_posts")
}
