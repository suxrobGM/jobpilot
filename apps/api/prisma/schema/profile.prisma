model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String
  phone     String?
  website   String?
  linkedin  String?
  github    String?

  street  String?
  aptUnit String? @map("apt_unit")
  city    String?
  state   String?
  zipCode String? @map("zip_code")
  country String?

  usAuthorized        Boolean @default(false) @map("us_authorized")
  requiresSponsorship Boolean @default(false) @map("requires_sponsorship")
  visaStatus          String? @map("visa_status")
  optExtension        String? @map("opt_extension")
  willingToRelocate   Boolean @default(false) @map("willing_to_relocate")
  preferredLocations  String  @default("[]") @map("preferred_locations")

  eeoGender           String? @map("eeo_gender")
  eeoRace             String? @map("eeo_race")
  eeoEthnicity        String? @map("eeo_ethnicity")
  eeoHispanicOrLatino String? @map("eeo_hispanic_or_latino")
  eeoVeteranStatus    String? @map("eeo_veteran_status")
  eeoDisabilityStatus String? @map("eeo_disability_status")

  primaryResumeId String?  @unique @map("primary_resume_id")
  primaryResume   Resume?  @relation("PrimaryResume", fields: [primaryResumeId], references: [id], onDelete: SetNull)
  resumes         Resume[]

  autoApply          AutoApplySettings?
  applications       Application[]
  campaigns          Campaign[]
  credentials        Credential[]
  jobBoards          ProfileJobBoard[]
  queueEntries       QueueEntry[]
  emailAccount       EmailAccount?
  emailOAuthClient   EmailOAuthClient?
  upworkProposals    UpworkProposal[]
  upworkProfile      UpworkProfile?
  references         Reference[]
  salaryPreferences  SalaryPreference[]
  contacts           Contact[]
  networkingMessages NetworkingMessage[]
  coverLetters       CoverLetter[]
  pilotState         PilotState?
  pilotLeases        PilotLease[]
  questions          Question[]
  pilotJournal       PilotJournalEntry[]
  pushSubscriptions  PushSubscription[]
  promotionPosts     PromotionPost[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("profiles")
}

model Reference {
  id           String  @id @default(uuid())
  profileId    String  @map("profile_id")
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  position     Int     @default(0)

  @@index([profileId])
  @@map("references")
}

model SalaryPreference {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  appliesTo String  @map("applies_to")
  minAmount Float?  @map("min_amount")
  maxAmount Float?  @map("max_amount")
  currency  String  @default("USD")
  period    String  @default("yearly")
  position  Int     @default(0)

  @@index([profileId])
  @@map("salary_preferences")
}

model AutoApplySettings {
  id                         String  @id @default(uuid())
  profileId                  String  @unique @map("profile_id")
  profile                    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  minMatchScore              Int     @default(60) @map("min_match_score")
  maxApplicationsPerCampaign Int?    @map("max_applications_per_campaign")
  defaultStartDate           String  @default("2 weeks notice") @map("default_start_date")

  @@map("auto_apply_settings")
}
