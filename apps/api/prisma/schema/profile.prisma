model ProfessionalReference {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  position     Int     @default(0)

  @@index([userId])
  @@map("professional_references")
}

model SalaryPreference {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliesTo String         @map("applies_to")
  minAmount Float?         @map("min_amount")
  maxAmount Float?         @map("max_amount")
  currency  SalaryCurrency @default(USD)
  period    SalaryPeriod   @default(yearly)
  position  Int            @default(0)

  @@index([userId])
  @@map("salary_preferences")
}

model AutoApplySettings {
  id                         String   @id @default(uuid())
  userId                     String   @unique @map("user_id")
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minMatchScore              Int      @default(60) @map("min_match_score")
  maxApplicationsPerCampaign Int?     @map("max_applications_per_campaign")
  defaultStartDate           String   @default("2 weeks notice") @map("default_start_date")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("auto_apply_settings")
}

// Answers the user gave, never the model's guesses.
model ProfileAnswer {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("profile_answers")
}

enum SalaryPeriod {
  yearly
  monthly
  hourly

  @@map("salary_period")
}

enum SalaryCurrency {
  USD
  EUR
  GBP
  CAD
  AUD
  INR

  @@map("salary_currency")
}
