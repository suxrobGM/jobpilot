enum Availability {
  open
  not_looking

  @@map("availability")
}

// The applicant: who they are on applications and on the public portfolio. One per user.
model Profile {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availability Availability?
  // Off the public portfolio until the owner opts in.
  showResume   Boolean       @default(false) @map("show_resume")
  showWebsite  Boolean       @default(false) @map("show_website")
  showLinkedin Boolean       @default(false) @map("show_linkedin")
  showGithub   Boolean       @default(false) @map("show_github")

  firstName    String  @default("") @map("first_name")
  lastName     String  @default("") @map("last_name")
  // Goes on applications; `email` is the login.
  contactEmail String  @default("") @map("contact_email")
  phone        String?
  website      String?
  linkedin     String?
  github       String?

  street  String?
  aptUnit String? @map("apt_unit")
  city    String?
  state   String?
  zipCode String? @map("zip_code")
  country String?

  usAuthorized        Boolean  @default(false) @map("us_authorized")
  requiresSponsorship Boolean  @default(false) @map("requires_sponsorship")
  visaStatus          String?  @map("visa_status")
  optExtension        String?  @map("opt_extension")
  willingToRelocate   Boolean  @default(false) @map("willing_to_relocate")
  preferredLocations  String[] @default([]) @map("preferred_locations")

  eeoGender           String? @map("eeo_gender")
  eeoRace             String? @map("eeo_race")
  eeoEthnicity        String? @map("eeo_ethnicity")
  eeoHispanicOrLatino String? @map("eeo_hispanic_or_latino")
  eeoVeteranStatus    String? @map("eeo_veteran_status")
  eeoDisabilityStatus String? @map("eeo_disability_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model ProfessionalReference {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  position     Int     @default(0)

  @@index([userId])
  @@map("professional_references")
}

model SalaryPreference {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliesTo String         @map("applies_to")
  minAmount Float?         @map("min_amount")
  maxAmount Float?         @map("max_amount")
  currency  SalaryCurrency @default(USD)
  period    SalaryPeriod   @default(yearly)
  position  Int            @default(0)

  @@index([userId])
  @@map("salary_preferences")
}

model AutoApplySettings {
  id                         String   @id @default(uuid())
  userId                     String   @unique @map("user_id")
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minMatchScore              Int      @default(60) @map("min_match_score")
  maxApplicationsPerCampaign Int?     @map("max_applications_per_campaign")
  defaultStartDate           String   @default("2 weeks notice") @map("default_start_date")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("auto_apply_settings")
}

// Answers the user gave, never the model's guesses.
model ProfileAnswer {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("profile_answers")
}

enum SalaryPeriod {
  yearly
  monthly
  hourly

  @@map("salary_period")
}

enum SalaryCurrency {
  USD
  EUR
  GBP
  CAD
  AUD
  INR

  @@map("salary_currency")
}
