model Resume {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String

  sourceFilename  String? @map("source_filename")
  sourceMimeType  String? @map("source_mime_type")
  sourceSizeBytes Int?    @map("source_size_bytes")

  content Json?
  version Int   @default(1)

  variants      ResumeVariant[]
  primaryFor    User?           @relation("PrimaryResume")
  applications  Application[]
  feeds         Feed[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("resumes")
}

model ResumeVariant {
  id       String @id @default(uuid(7)) @db.Uuid
  resumeId String @map("resume_id") @db.Uuid
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  label         String
  jobUrl        String?      @map("job_url")
  applicationId String?      @map("application_id") @db.Uuid
  application   Application? @relation("TailoredVariant", fields: [applicationId], references: [id], onDelete: SetNull)

  // `application` is the one this variant was tailored for; `submittedWith` are the ones that sent it.
  submittedWith Application[] @relation("SubmittedVariant")

  content     Json
  changeNotes String? @map("change_notes")

  // Audit of rewording and restructuring (`VariantRewriteAudit`); null when the variant only reranked.
  rewrites Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([resumeId])
  @@index([applicationId])
  @@map("resume_variants")
}
