model QueueEntry {
  id         String    @id @default(uuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url        String
  note       String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@unique([profileId, url])
  @@index([profileId, status])
  @@index([status])
}
