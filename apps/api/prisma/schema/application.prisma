// Superset of CampaignSource: a row created from a campaign job carries that
// campaign's source, a single apply carries how the agent was invoked.
enum ApplicationSource {
  apply
  auto_apply
  manual
  search
  networking

  @@map("application_source")
}

// Activity-timeline event kinds on an application.
enum ApplicationEventKind {
  status_change
  note
  email

  @@map("application_event_kind")
}

// What originated an activity event.
enum ApplicationEventSource {
  manual
  email
  campaign

  @@map("application_event_source")
}

enum ApplicationStatus {
  applied
  screening
  interviewing
  offer
  rejected
  withdrawn

  @@map("application_status")
}

model Application {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  title     String
  company   String
  location  String?
  board     String?
  source    ApplicationSource
  appliedAt DateTime @default(now()) @map("applied_at")

  status     ApplicationStatus @default(applied)
  rejectedAt DateTime?         @map("rejected_at")

  matchScore  Int?    @map("match_score")
  matchReason String? @map("match_reason")
  failReason  String? @map("fail_reason")

  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)

  // The resume actually submitted: the base, plus the tailored variant when one was used. Reported by
  // the agent on the job result - `resumeVariants` below is the reverse list of variants created for
  // this application, which is empty whenever tailoring reused an existing variant.
  resumeId          String?        @map("resume_id")
  resume            Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeVariantId   String?        @map("resume_variant_id")
  resumeVariantUsed ResumeVariant? @relation("ApplicationResumeUsed", fields: [resumeVariantId], references: [id], onDelete: SetNull)

  events         ApplicationEvent[]
  emailMessages  EmailMessage[]
  resumeVariants ResumeVariant[]
  contacts       Contact[]
  coverLetters   CoverLetter[]

  @@unique([userId, url])
  // The duplicate scan filters on both columns; this also serves the bare userId lookups.
  @@index([userId, appliedAt])
  @@index([appliedAt])
  @@index([campaignId])
  // Both FKs are SetNull, so deleting a resume or variant scans this table without them.
  @@index([resumeId])
  @@index([resumeVariantId])
  @@map("applications")
}

model ApplicationEvent {
  id            String             @id @default(uuid())
  applicationId String             @map("application_id")
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          ApplicationEventKind
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus? @map("to_status")
  note          String?
  source        ApplicationEventSource?
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("application_events")
}
