enum ApplicationStatus {
  applied
  screening
  interviewing
  offer
  rejected
  withdrawn

  @@map("application_status")
}

model Application {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  title     String
  company   String
  location  String?
  board     String?
  source    String
  appliedAt DateTime @default(now()) @map("applied_at")

  status     ApplicationStatus @default(applied)
  rejectedAt DateTime?         @map("rejected_at")

  matchScore  Int?    @map("match_score")
  matchReason String? @map("match_reason")
  failReason  String? @map("fail_reason")

  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)

  events         ApplicationEvent[]
  emailMessages  EmailMessage[]
  resumeVariants ResumeVariant[]
  contacts       Contact[]

  @@unique([userId, url])
  // The duplicate scan filters on both columns; this also serves the bare userId lookups.
  @@index([userId, appliedAt])
  @@index([appliedAt])
  @@index([campaignId])
  @@map("applications")
}

model ApplicationEvent {
  id            String             @id @default(uuid())
  applicationId String             @map("application_id")
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String // "status_change" | "note" | "email"
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus? @map("to_status")
  note          String?
  source        String? // "manual" | "email" | "campaign"
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("application_events")
}
