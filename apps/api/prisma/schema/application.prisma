// CampaignSource plus `manual`.
enum ApplicationSource {
  apply
  auto_apply
  manual
  search
  networking

  @@map("application_source")
}

enum ApplicationEventKind {
  status_change
  note
  email
  // Its presence stops the pilot offering another prep sheet.
  interview_prep

  @@map("application_event_kind")
}

enum ApplicationEventSource {
  manual
  email
  campaign

  @@map("application_event_source")
}

enum ApplicationStatus {
  applied
  screening
  interviewing
  offer
  rejected
  withdrawn

  @@map("application_status")
}

model Application {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  title     String
  company   String
  location  String?
  boardId   String?           @map("board_id")
  board     JobBoard?         @relation(fields: [boardId], references: [id], onDelete: SetNull)
  source    ApplicationSource
  appliedAt DateTime          @default(now()) @map("applied_at")

  status ApplicationStatus @default(applied)

  matchScore  Int?    @map("match_score")
  matchReason String? @map("match_reason")

  campaignId String?      @map("campaign_id")
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Always a job of `campaignId`.
  jobId      String?      @map("job_id")
  job        CampaignJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // The resume actually submitted; `resumeVariants` are the ones tailored for this application.
  resumeId          String?        @map("resume_id")
  resume            Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeVariantId   String?        @map("resume_variant_id")
  resumeVariantUsed ResumeVariant? @relation("ApplicationResumeUsed", fields: [resumeVariantId], references: [id], onDelete: SetNull)

  events         ApplicationEvent[]
  emailMessages  EmailMessage[]
  resumeVariants ResumeVariant[]
  contacts       Contact[]
  coverLetters   CoverLetter[]

  @@unique([userId, url])
  @@index([boardId])
  // The duplicate scan; also serves userId lookups.
  @@index([userId, appliedAt])
  @@index([appliedAt])
  @@index([campaignId])
  @@index([jobId])
  // Back the SetNull FKs.
  @@index([resumeId])
  @@index([resumeVariantId])
  @@map("applications")
}

model ApplicationEvent {
  id            String                  @id @default(uuid())
  applicationId String                  @map("application_id")
  application   Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          ApplicationEventKind
  fromStatus    ApplicationStatus?      @map("from_status")
  toStatus      ApplicationStatus?      @map("to_status")
  note          String?
  source        ApplicationEventSource?
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("application_events")
}
