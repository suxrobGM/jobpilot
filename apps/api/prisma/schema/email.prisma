enum EmailClassification {
  interviewing
  rejected
  offer
  irrelevant
  verification

  @@map("email_classification")
}

enum EmailReviewStatus {
  pending
  approved
  denied
  auto

  @@map("email_review_status")
}

model EmailAccount {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String
  accessToken     String?   @map("access_token")
  refreshToken    String?   @map("refresh_token")
  tokenExpiresAt  DateTime? @map("token_expires_at")
  scope           String?
  historyId       String?   @map("history_id")
  lastSyncAt      DateTime? @map("last_sync_at")
  // Set on invalid_grant: the mailbox needs reconnecting. Cleared on the next good refresh.
  refreshFailedAt DateTime? @map("refresh_failed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  messages EmailMessage[]

  @@map("email_accounts")
}

// Separate from EmailAccount so it exists before connecting and survives a disconnect.
model EmailOAuthClient {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String   @map("client_id")
  clientSecret String   @map("client_secret") // encrypted
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_oauth_clients")
}

model EmailMessage {
  id          String       @id @default(uuid())
  accountId   String       @map("account_id")
  account     EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerId  String       @map("provider_id")
  threadId    String?      @map("thread_id")
  subject     String
  fromAddress String       @map("from_address")
  fromName    String?      @map("from_name")
  fromDomain  String       @map("from_domain")
  snippet     String
  body        String
  receivedAt  DateTime     @map("received_at")
  fetchedAt   DateTime     @default(now()) @map("fetched_at")

  scannedAt       DateTime?            @map("scanned_at")
  classification  EmailClassification?
  confidence      Float?
  reasoning       String?
  applicationId   String?              @map("application_id")
  application     Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  matchConfidence Float?               @map("match_confidence")
  reviewStatus    EmailReviewStatus    @default(pending) @map("review_status")
  resultingStatus ApplicationStatus?   @map("resulting_status")

  verificationCode   String? @map("verification_code")
  verificationLink   String? @map("verification_link")
  verificationDomain String? @map("verification_domain")

  // `[{url, text}]`, captured at sync: the body drops hrefs, and a tracker URL needs its anchor text.
  links      Json      @default("[]")
  // Set once the pilot imports this job-alert email's links.
  importedAt DateTime? @map("imported_at")

  // Provider message ids are unique per mailbox, not globally.
  @@unique([accountId, providerId])
  // Every read is scoped through `account: { userId }`, so each filter index leads with the account.
  @@index([accountId, reviewStatus, receivedAt])
  @@index([accountId, fromDomain, receivedAt])
  @@index([accountId, verificationDomain, receivedAt])
  @@index([applicationId])
  @@index([receivedAt]) // Retention sweep.
  @@map("email_messages")
}
