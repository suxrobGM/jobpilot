enum EmailProvider {
  gmail
  outlook
  imap

  @@map("email_provider")
}

enum EmailClassification {
  interviewing
  rejected
  offer
  irrelevant
  verification

  @@map("email_classification")
}

enum EmailReviewStatus {
  pending
  approved
  denied
  auto

  @@map("email_review_status")
}

model EmailAccount {
  id              String        @id @default(uuid())
  userId          String        @unique @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        EmailProvider
  email           String
  accessToken     String?       @map("access_token")
  refreshToken    String?       @map("refresh_token")
  tokenExpiresAt  DateTime?     @map("token_expires_at")
  scope           String?
  historyId       String?       @map("history_id")
  lastSyncAt      DateTime?     @map("last_sync_at")
  // Set on invalid_grant: the mailbox needs reconnecting. Cleared on the next good refresh.
  refreshFailedAt DateTime?     @map("refresh_failed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  messages EmailMessage[]

  @@map("email_accounts")
}

// Separate from EmailAccount so it exists before connecting and survives a disconnect.
model EmailOAuthClient {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     EmailProvider @default(gmail)
  clientId     String        @map("client_id") // plaintext (semi-public)
  clientSecret String        @map("client_secret") // ciphertext (per-user DEK)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("email_oauth_clients")
}

model EmailMessage {
  id          String       @id @default(uuid())
  accountId   String       @map("account_id")
  account     EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerId  String       @unique @map("provider_id")
  threadId    String?      @map("thread_id")
  subject     String
  fromAddress String       @map("from_address")
  fromName    String?      @map("from_name")
  fromDomain  String       @map("from_domain")
  snippet     String
  rawBody     String       @map("raw_body")
  receivedAt  DateTime     @map("received_at")
  fetchedAt   DateTime     @default(now()) @map("fetched_at")

  scannedAt      DateTime?            @map("scanned_at")
  classification EmailClassification?
  confidence     Float?
  reasoning      String?
  matchedAppId   String?              @map("matched_app_id")
  matchedApp     Application?         @relation(fields: [matchedAppId], references: [id], onDelete: SetNull)
  matchScore     Float?               @map("match_score")
  reviewStatus   EmailReviewStatus    @default(pending) @map("review_status")
  appliedStatus  ApplicationStatus?   @map("applied_status")

  verificationCode   String? @map("verification_code")
  verificationLink   String? @map("verification_link")
  verificationDomain String? @map("verification_domain")

  // `[{url, text}]` for every link, captured at sync: rawBody drops hrefs, and a job-alert tracker
  // URL means nothing without its anchor text.
  links       Json      @default("[]")
  // Set once the pilot has pulled this alert email's job links into a campaign.
  harvestedAt DateTime? @map("harvested_at")

  @@index([reviewStatus, receivedAt])
  @@index([matchedAppId])
  @@index([fromDomain, receivedAt])
  @@index([verificationDomain, receivedAt])
  @@index([receivedAt]) // Retention sweep; no other index leads with receivedAt.
  @@map("email_messages")
}
