model EmailAccount {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  email          String
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  scope          String?
  historyId      String?   @map("history_id")
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages EmailMessage[]

  @@map("email_accounts")
}

// Per-user Google OAuth client; separate from EmailAccount so it pre-dates connection and survives disconnect.
model EmailOAuthClient {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("gmail")
  clientId     String   @map("client_id") // plaintext (semi-public)
  clientSecret String   @map("client_secret") // ciphertext (per-user DEK)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_oauth_clients")
}

model EmailMessage {
  id          String       @id @default(uuid())
  accountId   String       @map("account_id")
  account     EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerId  String       @unique @map("provider_id")
  threadId    String?      @map("thread_id")
  subject     String
  fromAddress String       @map("from_address")
  fromName    String?      @map("from_name")
  fromDomain  String       @map("from_domain")
  snippet     String
  rawBody     String       @map("raw_body")
  receivedAt  DateTime     @map("received_at")
  fetchedAt   DateTime     @default(now()) @map("fetched_at")

  scannedAt      DateTime?    @map("scanned_at")
  classification String?
  confidence     Float?
  reasoning      String?
  matchedAppId   String?      @map("matched_app_id")
  matchedApp     Application? @relation(fields: [matchedAppId], references: [id], onDelete: SetNull)
  matchScore     Float?       @map("match_score")
  reviewStatus   String       @default("pending") @map("review_status")
  appliedStatus  String?      @map("applied_status")

  verificationCode   String? @map("verification_code")
  verificationLink   String? @map("verification_link")
  verificationDomain String? @map("verification_domain")

  @@index([reviewStatus, receivedAt])
  @@index([matchedAppId])
  @@index([fromDomain, receivedAt])
  @@index([verificationDomain, receivedAt])
  @@index([receivedAt]) // Retention sweep; every other index leads with a column it does not filter on.
  @@map("email_messages")
}
