enum UpworkProposalStatus {
  draft
  submitted
  closed

  @@map("upwork_proposal_status")
}

enum UpworkProposalOutcome {
  hired
  declined
  no_response

  @@map("upwork_proposal_outcome")
}

enum UpworkProposalSource {
  manual
  search

  @@map("upwork_proposal_source")
}

enum UpworkProfileStatus {
  empty
  draft
  approved
  applied

  @@map("upwork_profile_status")
}

enum UpworkInboxKind {
  invitation
  offer
  message

  @@map("upwork_inbox_kind")
}

enum UpworkInboxStatus {
  unread
  archived

  @@map("upwork_inbox_status")
}

model UpworkProposal {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle       String  @map("job_title")
  clientName     String? @map("client_name")
  jobUrl         String? @map("job_url")
  jobDescription String? @map("job_description")

  proposalText     String @default("") @map("proposal_text")
  screeningAnswers Json   @default("[]") @map("screening_answers") // screeningAnswerSchema[]

  status  UpworkProposalStatus   @default(draft)
  outcome UpworkProposalOutcome?
  notes   String?

  source UpworkProposalSource @default(manual)
  // The campaign job a `search` draft was seeded from.
  jobId  String?              @map("job_id")
  job    Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  submittedAt DateTime? @map("submitted_at")

  @@index([userId, status])
  @@index([jobId])
  @@map("upwork_proposals")
}

// Only an `approved` row may be written back to Upwork. Portfolio columns hold
// portfolioProjectSchema[]; the MCP cannot write portfolio or hourly rate, so those two stay advisory.
model UpworkProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentTitle      String?  @map("current_title")
  currentOverview   String?  @map("current_overview")
  currentHourlyRate String?  @map("current_hourly_rate")
  currentPortfolio  Json     @default("[]") @map("current_portfolio")
  currentSkills     String[] @default([]) @map("current_skills")

  suggestedTitle      String?  @map("suggested_title")
  suggestedOverview   String?  @map("suggested_overview")
  suggestedHourlyRate String?  @map("suggested_hourly_rate")
  suggestedPortfolio  Json     @default("[]") @map("suggested_portfolio")
  suggestedSkills     String[] @default([]) @map("suggested_skills")

  status    UpworkProfileStatus @default(empty)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  appliedAt DateTime?           @map("applied_at")

  @@map("upwork_profiles")
}

// Mirrored by the sync skill: the Upwork MCP runs in the local agent, out of the browser's reach.
model UpworkAccount {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  connectsBalance Int? @map("connects_balance")

  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("upwork_accounts")
}

// `upworkId` keeps the sync idempotent; `payload` keeps the full item for fields not modeled yet.
model UpworkInboxItem {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  upworkId   String          @map("upwork_id")
  kind       UpworkInboxKind
  title      String
  clientName String?         @map("client_name")
  jobUrl     String?         @map("job_url")
  body       String?

  status     UpworkInboxStatus @default(unread)
  receivedAt DateTime          @map("received_at")
  payload    Json              @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, upworkId])
  @@index([userId, kind, receivedAt])
  @@index([userId, status])
  @@map("upwork_inbox_items")
}
