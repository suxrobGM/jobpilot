// super_admin is a singleton granted only from SUPER_ADMIN_EMAIL (seed / register); no API route assigns it.
enum UserRole {
  super_admin
  admin
  user

  @@map("user_role")
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  // Null for OAuth-only accounts; the security page lets them set one later.
  passwordHash     String?   @map("password_hash")
  role             UserRole  @default(user)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  // Encrypted under SECRET_MASTER_KEY; decrypts this account's secrets, so deleting the account
  // crypto-shreds them.
  encryptedDataKey String?   @map("encrypted_data_key")

  username String @unique

  primaryResumeId String? @unique @map("primary_resume_id") @db.Uuid
  primaryResume   Resume? @relation("PrimaryResume", fields: [primaryResumeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile            Profile?
  authTokens         AuthToken[]
  verificationTokens VerificationToken[]
  oauthAccounts      OAuthAccount[]

  resumes              Resume[]
  applications         Application[]
  campaigns            Campaign[]
  campaignJobs         CampaignJob[]
  credentials          Credential[]
  jobBoards            UserJobBoard[]
  emailAccount         EmailAccount?
  emailOAuthClient     EmailOAuthClient?
  upworkProposals      UpworkProposal[]
  upworkProfile        UpworkProfile?
  upworkAccount        UpworkAccount?
  upworkInboxItems     UpworkInboxItem[]
  references           ProfessionalReference[]
  salaryPreferences    SalaryPreference[]
  contacts             Contact[]
  networkingMessages   NetworkingMessage[]
  coverLetters         CoverLetter[]
  pilotState           PilotState?
  pilotSearches        PilotSearch[]
  pilotRuns            PilotRun[]
  pilotQuestions       PilotQuestion[]
  pilotChanges         PilotChange[]
  pilotMessages        PilotMessage[]
  pilotRequests        PilotRequest[]
  pilotJournal         PilotJournalEntry[]
  profileAnswers       ProfileAnswer[]
  webPushSubscriptions WebPushSubscription[]
  promotionPosts       PromotionPost[]

  @@map("users")
}
