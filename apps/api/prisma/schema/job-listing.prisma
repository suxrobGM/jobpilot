enum JobListingStatus {
  published
  hidden

  @@map("job_listing_status")
}

// The public job index: one row per posting, deduped across all users. Must never record who
// discovered or applied.
model JobListing {
  id        String @id @default(uuid())
  slug      String @unique
  // sha256(normTitle|normCompany|normLocation).
  dedupeKey String @unique @map("dedupe_key")

  title              String
  company            String
  location           String?
  remote             Boolean  @default(false)
  salary             String?
  employmentType     String?  @map("employment_type")
  skills             String[]
  descriptionExcerpt String?  @map("description_excerpt")
  // From the agent's brief; older postings stay empty until re-scraped.
  requirements       String[]
  responsibilities   String[]
  yearsExperience    Int?     @map("years_experience")

  // Auto-published behind the ingest quality gate; admins hide after the fact.
  status      JobListingStatus @default(published)
  firstSeenAt DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime         @default(now()) @map("last_seen_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sources JobListingSource[]

  // Default list and sitemap.
  @@index([status, lastSeenAt])
  // `?sort=newest` and `?posted=`.
  @@index([status, firstSeenAt])
  // `?tech=` is a `skills @> ARRAY[..]` containment test - btree cannot serve it.
  @@index([skills], type: Gin)
  // Trigram indexes serve the `?q=` ILIKE '%term%' search.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_listings_title_trgm_idx")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_listings_company_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_listings_location_trgm_idx")
  @@map("job_listings")
}

// Where one posting was seen. A repost across boards collapses into one JobListing with several
// sources; `url @unique` is what keeps the ingest upsert atomic under concurrent agents.
model JobListingSource {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  boardId    String?  @map("board_id")
  // Normalized by normalizeJobUrl.
  url        String   @unique
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  board   JobBoard?  @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([boardId, listingId])
  @@map("job_listing_sources")
}
