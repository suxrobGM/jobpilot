model JobBoard {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  domain    String
  searchUrl String?
  email     String?
  password  String?
  sortOrder Int     @default(0)

  @@unique([profileId, domain])
  @@index([profileId])
}
