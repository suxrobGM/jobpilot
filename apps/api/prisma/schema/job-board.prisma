// The global, admin-curated board catalog. A user adding an unknown domain creates an unlisted row.
model JobBoard {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  searchUrl String?  @map("search_url")
  // Offered to other users in the board picker. User-created boards start unlisted.
  listed    Boolean  @default(false)
  // Auto-linked to every new user at registration.
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userBoards UserJobBoard[]

  @@map("job_boards")
}

// A user's adoption of a global board. Logins live in Credential, keyed by the board's domain.
model UserJobBoard {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  jobBoardId String   @map("job_board_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobBoard JobBoard @relation(fields: [jobBoardId], references: [id], onDelete: Cascade)

  @@unique([userId, jobBoardId])
  @@index([userId])
  @@map("user_job_boards")
}
