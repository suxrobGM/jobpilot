enum CampaignSource {
  search
  auto_apply
  apply
  networking

  @@map("campaign_source")
}

enum CampaignStatus {
  in_progress
  paused
  completed
  failed

  @@map("campaign_status")
}

// A pilot feed that keeps one standing campaign. Search feeds are keyed by `pilotSearchId` instead.
enum CampaignFeed {
  job_alerts
  research

  @@map("campaign_feed")
}

// Self-reported: every actor calls with the user's own token.
enum Actor {
  user
  agent
  pilot

  @@map("actor")
}

model Campaign {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query           String
  source          CampaignSource
  status          CampaignStatus @default(in_progress)
  createdBy       Actor          @default(user) @map("created_by")
  statusChangedBy Actor?         @map("status_changed_by")
  statusReason    String?        @map("status_reason")
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  config          Json           @default("{}")
  // Null for campaigns of pasted links.
  boardId         String?        @map("board_id") @db.Uuid
  board           JobBoard?      @relation(fields: [boardId], references: [id], onDelete: SetNull)
  // Discovery matches on this, not the query text: the pilot may rewrite the query.
  pilotSearchId   String?        @map("pilot_search_id") @db.Uuid
  // One open campaign per feed or search: partial unique indexes, hand-written in the migration.
  feed            CampaignFeed?

  jobs               CampaignJob[]
  applications       Application[]
  networkingMessages NetworkingMessage[]
  pilotSearch        PilotSearch?        @relation(fields: [pilotSearchId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, status, startedAt])
  @@index([userId, source, startedAt])
  @@index([userId, pilotSearchId])
  @@index([pilotSearchId])
  // The pilot activity probe takes MAX(updatedAt) per user every two minutes.
  @@index([userId, updatedAt])
  @@index([boardId])
  @@map("campaigns")
}
