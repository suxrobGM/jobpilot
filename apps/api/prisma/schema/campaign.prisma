enum CampaignSource {
  search
  auto_apply
  apply
  networking

  @@map("campaign_source")
}

enum CampaignStatus {
  in_progress
  paused
  completed
  failed

  @@map("campaign_status")
}

// Self-reported: every actor calls with the user's own token.
enum CampaignActor {
  user
  agent
  pilot

  @@map("campaign_actor")
}

model Campaign {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  source        CampaignSource
  status        CampaignStatus @default(in_progress)
  createdBy     CampaignActor  @default(user) @map("created_by")
  statusActor   CampaignActor? @map("status_actor")
  statusReason  String?        @map("status_reason")
  startedAt     DateTime       @default(now()) @map("started_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  completedAt   DateTime?      @map("completed_at")
  config        Json           @default("{}")
  // Null for campaigns of pasted links.
  boardId       String?        @map("board_id")
  board         JobBoard?      @relation(fields: [boardId], references: [id], onDelete: SetNull)
  // Discovery matches on this, not the query text: the pilot may rewrite the query.
  pilotSearchId String?        @map("pilot_search_id")

  jobs               CampaignJob[]
  applications       Application[]
  networkingMessages NetworkingMessage[]
  pilotSearch        PilotSearch?        @relation(fields: [pilotSearchId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, status, startedAt])
  @@index([userId, source, startedAt])
  @@index([userId, pilotSearchId])
  @@index([pilotSearchId])
  // The pilot activity probe takes MAX(updatedAt) per user every two minutes.
  @@index([userId, updatedAt])
  @@index([boardId])
  @@map("campaigns")
}
