enum CredentialKind {
  // A login for one board.
  board
  // The login tried on any board without its own.
  default
  // An API key for a captcha-solving service.
  service

  @@map("credential_kind")
}

enum CaptchaProvider {
  two_captcha
  capsolver

  @@map("captcha_provider")
}

// One default per user is a partial unique index in the migration SQL: Prisma can't express it.
model Credential {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      CredentialKind
  // Set only for `board`.
  boardId   String?          @map("board_id") @db.Uuid
  // Restrict: deleting a catalog board must not silently drop users' logins.
  board     JobBoard?        @relation(fields: [boardId], references: [id], onDelete: Restrict)
  // Set only for `service`.
  provider  CaptchaProvider?
  email     String?
  password  String?
  apiKey    String?          @map("api_key")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, boardId])
  @@unique([userId, provider])
  @@index([boardId])
  @@map("credentials")
}
