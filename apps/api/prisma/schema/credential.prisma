model Credential {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scope     String
  email     String?
  password  String?
  apiKey    String? @map("api_key")

  @@unique([profileId, scope])
  @@index([profileId])
  @@map("credential")
}
