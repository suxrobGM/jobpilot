enum CampaignJobStatus {
  queued
  pending
  approved
  applying
  applied
  failed
  skipped
  needs_user

  @@map("campaign_job_status")
}

model Job {
  id          String            @id @default(uuid())
  campaignId  String            @map("campaign_id")
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  key         String
  title       String
  company     String
  location    String?
  salary      String?
  type        String?
  url         String
  boardId     String?           @map("board_id")
  board       JobBoard?         @relation(fields: [boardId], references: [id], onDelete: SetNull)
  matchScore  Int?              @map("match_score")
  matchReason String?           @map("match_reason")
  status      CampaignJobStatus @default(pending)
  appliedAt   DateTime?         @map("applied_at")
  failReason  String?           @map("fail_reason")
  retryNotes  String?           @map("retry_notes")
  skipReason  String?           @map("skip_reason")
  description String?
  brief       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  applications Application[]

  @@unique([campaignId, key])
  @@index([campaignId, status])
  @@index([status, updatedAt])
  // Pilot activity probe, as on Campaign.
  @@index([campaignId, updatedAt])
  @@index([boardId])
  @@map("jobs")
}
