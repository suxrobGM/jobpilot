enum CampaignJobStatus {
  queued
  pending
  approved
  applying
  applied
  failed
  skipped
  needs_user

  @@map("campaign_job_status")
}

model Job {
  id          String            @id @default(uuid())
  campaignId  String            @map("campaign_id")
  campaign    Campaign          @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  key         String
  title       String
  company     String
  location    String?
  salary      String?
  type        String?
  url         String
  board       String?
  matchScore  Int?              @map("match_score")
  matchReason String?           @map("match_reason")
  status      CampaignJobStatus @default(pending)
  appliedAt   DateTime?         @map("applied_at")
  /// Stamped just before the agent submits the form. Recovery parks every interrupted apply for
  /// the user either way; the stamp only sharpens the question to "you were mid-submit".
  submitAttemptedAt DateTime?   @map("submit_attempted_at")
  failReason  String?           @map("fail_reason")
  retryNotes  String?           @map("retry_notes")
  skipReason  String?           @map("skip_reason")
  description String?
  brief       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([campaignId, key])
  @@index([campaignId, status])
  // The application detail resolves its posting by url within the campaign; no FK links the two.
  @@index([campaignId, url])
  @@index([status, updatedAt])
  // Pilot activity probe, as on Campaign.
  @@index([campaignId, updatedAt])
  @@map("jobs")
}
