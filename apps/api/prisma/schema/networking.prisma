enum NetworkingChannel {
  email
  linkedin
}

enum LinkedinMessageKind {
  inmail
  connect_note
  dm
}

enum NetworkingMessageStatus {
  draft
  approved
  sent
  replied
  bounced
  failed
  skipped
}

enum ContactEmailSource {
  guessed
  verified
  provided
}

enum ContactLinkedinConnection {
  none
  pending
  connected
}

enum ContactDiscoverySource {
  google
  company_site @map("company-site")
  web
  linkedin
  manual
}

model Contact {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  title           String?
  company         String?
  linkedinUrl     String? @map("linkedin_url")
  email           String?
  emailSource     ContactEmailSource? @map("email_source")
  emailConfidence Float?  @map("email_confidence")

  linkedinConnection ContactLinkedinConnection @default(none) @map("linkedin_connection")
  discoverySource    ContactDiscoverySource?    @map("discovery_source")
  matchConfidence    Float?                     @map("match_confidence")

  relatedAppId  String?      @map("related_app_id")
  relatedApp    Application? @relation(fields: [relatedAppId], references: [id], onDelete: SetNull)
  relatedJobUrl String?      @map("related_job_url")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages NetworkingMessage[]

  @@index([userId])
  @@index([userId, company])
  @@map("contacts")
}

model NetworkingMessage {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId  String    @map("contact_id")
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)

  channel      NetworkingChannel
  linkedinKind LinkedinMessageKind? @map("linkedin_kind")
  subject      String?
  body         String               @default("")

  status     NetworkingMessageStatus @default(draft)
  failReason String?                 @map("fail_reason")
  providerId String?                 @map("provider_id")
  threadId   String?                 @map("thread_id")
  sentAt     DateTime?               @map("sent_at")
  repliedAt  DateTime?               @map("replied_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([threadId])
  @@index([userId, status, sentAt])
  @@map("networking_messages")
}
