enum NetworkingChannel {
  email
  linkedin

  @@map("networking_channel")
}

enum LinkedinMessageKind {
  inmail
  connect_note
  dm

  @@map("linkedin_message_kind")
}

enum NetworkingMessageStatus {
  draft
  approved
  sent
  replied
  bounced
  failed
  skipped

  @@map("networking_message_status")
}

enum ContactEmailSource {
  guessed
  verified
  provided

  @@map("contact_email_source")
}

enum ContactLinkedinConnection {
  none
  pending
  connected

  @@map("contact_linkedin_connection")
}

enum ContactDiscoverySource {
  google
  company_site
  web
  linkedin
  manual

  @@map("contact_discovery_source")
}

model Contact {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  title           String?
  company         String?
  linkedinUrl     String?             @map("linkedin_url")
  email           String?
  emailSource     ContactEmailSource? @map("email_source")
  emailConfidence Float?              @map("email_confidence")

  linkedinConnection ContactLinkedinConnection @default(none) @map("linkedin_connection")
  discoverySource    ContactDiscoverySource?   @map("discovery_source")
  matchConfidence    Float?                    @map("match_confidence")

  applicationId String?      @map("application_id") @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobUrl        String?      @map("job_url")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages NetworkingMessage[]

  @@index([userId, company])
  @@index([applicationId])
  @@map("contacts")
}

model NetworkingMessage {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId  String    @map("contact_id") @db.Uuid
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  feedId String? @map("feed_id") @db.Uuid
  feed   Feed?   @relation(fields: [feedId], references: [id], onDelete: SetNull)

  channel      NetworkingChannel
  linkedinKind LinkedinMessageKind? @map("linkedin_kind")
  subject      String?
  body         String               @default("")

  status     NetworkingMessageStatus @default(draft)
  failReason String?                 @map("fail_reason")
  providerId String?                 @map("provider_id")
  threadId   String?                 @map("thread_id")
  sentAt     DateTime?               @map("sent_at") @db.Timestamptz(3)
  repliedAt  DateTime?               @map("replied_at") @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([feedId, status])
  @@index([contactId])
  @@index([threadId])
  @@index([userId, status, sentAt])
  @@map("networking_messages")
}
