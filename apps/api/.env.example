# Backend (Elysia) — copy to `.env` for local dev. Bun auto-loads this file.
NODE_ENV=development
PORT=8002

# Postgres (matches docker-compose.dev.yml — host 5433 to avoid the local PG service on 5432)
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5433/jobpilot

# Auth — generate a real secret for anything beyond local dev: `openssl rand -hex 32`
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=30d

# At-rest encryption master key (base64 of 32 bytes): `openssl rand -base64 32`.
# Wraps each user's data key; in production load it from a secrets manager.
SECRET_MASTER_KEY=

# Browser origins allowed by CORS (comma-separated, credentials mode)
CORS_ORIGINS=http://localhost:8000
APP_URL=http://localhost:8000

# Local file storage root for resumes / generated PDFs / backups
STORAGE_ROOT=./storage

LOG_LEVEL=info

# Google OAuth (Gmail). Add http://localhost:8002/api/email/oauth/callback as an
# authorized redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8002/api/email/oauth/callback
