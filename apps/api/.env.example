# Backend (Elysia) - copy to `.env` for local dev. Bun auto-loads this file.
NODE_ENV=development
PORT=4101

# Postgres - whichever one you supplied: a local instance you run yourself, or the SSH tunnel
# below (see db:tunnel). Both conventionally bind 5433, leaving 5432 to a local PG service.
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5433/jobpilot

# Remote DB via SSH tunnel
SSH_TUNNEL_HOST=bastion.example.com
SSH_TUNNEL_USER=root
SSH_TUNNEL_KEY=~/.ssh/id_ed25519
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=5432
LOCAL_DB_PORT=5433

# Auth - generate a real secret for anything beyond local dev: `openssl rand -hex 32`
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=30d

# At-rest encryption master key (base64 of 32 bytes): `openssl rand -base64 32`.
# Wraps each user's data key; in production load it from a secrets manager.
SECRET_MASTER_KEY=

# The single super admin
SUPER_ADMIN_EMAIL=

# Browser origins allowed by CORS (comma-separated, credentials mode)
CORS_ORIGINS=http://localhost:4100
APP_URL=http://localhost:4100

# Local file storage root for resumes / generated PDFs
STORAGE_ROOT=./storage

LOG_LEVEL=info

# Google OAuth (Gmail) callback URL. Client id/secret are per-user (Settings → Email);
# each user registers this URL as an authorized redirect URI in their own Google client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4101/api/email/oauth/callback

# Google/GitHub sign-in (shared app clients; unset = provider disabled). Register the
# callback with each provider: {AUTH_OAUTH_REDIRECT_BASE}/api/auth/providers/{google,github}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_OAUTH_REDIRECT_BASE=http://localhost:4101

# Transactional email (Resend). Leave RESEND_API_KEY empty for local dev - the app
# logs verification/reset magic links to the console instead of sending
RESEND_API_KEY=
EMAIL_FROM=JobPilot <onboarding@resend.dev>

# Web push (VAPID). Empty = push disabled; the Settings → Notifications card explains
# it's unconfigured. Generate a key pair: `bunx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
