{
  "name": "@jobpilot/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "module": "src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "types": "./src/app.ts",
  "scripts": {
    "dev": "bun run --watch src/app.ts",
    "start": "bun run src/app.ts",
    "build": "bun build --compile --minify --target bun-windows-x64 --outfile dist/server.exe src/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prebuild": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --create-only",
    "db:migrate:apply": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --skip-seed"
  },
  "dependencies": {
    "@2captcha/captcha-solver": "^1.3.8",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@jobpilot/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@react-pdf/renderer": "^4.5.1",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.8",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "tsyringe": "^4.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
